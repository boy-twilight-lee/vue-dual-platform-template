{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		/* Bundler mode */
		"moduleDetection": "force",
		/* Linting */
		"noUnusedLocals": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"types": ["node"]
	},
	"include": ["vite.config.ts", "plugins/**/*.ts"]
}
